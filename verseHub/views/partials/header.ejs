<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VerseHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/mixins/_box-shadow.scss" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="fa-solid fa-feather-pointed me-2"></i>VerseHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/poems">Poemas</a></li>
                    <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <% if (user) { %>
                        <li class="nav-item"><a class="nav-link" href="/user/favorites"><i class="fa-solid fa-bookmark me-1"></i> Favoritos</a></li>
                        <li class="nav-item"><a class="nav-link" href="/user/profile/<%= user._id %>">Meu Perfil</a></li>
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm ms-2 mt-1" href="/auth/logout">Sair</a></li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="/auth/login">Entrar</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm ms-2 mt-1" href="/auth/register">Cadastrar</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container my-5 flex-grow-1">