<%- include('../partials/header') %>
<h2 class="fw-bold mb-4">Dashboard Global da Aplicação</h2>
<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card border-0 bg-primary text-white shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="fa-solid fa-users fa-3x mb-3"></i>
                <h5 class="card-title text-white-50">Usuários Cadastrados</h5>
                <h2 class="display-5 fw-bold"><%= totalUsers %></h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 bg-success text-white shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="fa-solid fa-scroll fa-3x mb-3"></i>
                <h5 class="card-title text-white-50">Total de Poemas</h5>
                <h2 class="display-5 fw-bold"><%= totalPoems %></h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-0 bg-warning text-white shadow-sm">
            <div class="card-body p-4 text-center">
                <i class="fa-solid fa-comments fa-3x mb-3"></i>
                <h5 class="card-title text-white-50">Comentários Realizados</h5>
                <h2 class="display-5 fw-bold"><%= totalComments %></h2>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>