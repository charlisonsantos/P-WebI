<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <h2 class="fw-bold m-0">Poemas da Comunidade</h2>
    <% if(user) { %>
        <a href="/poems/create" class="btn btn-success"><i class="fa-solid fa-plus me-1"></i> Criar Poema</a>
    <% } %>
</div>

<form action="/poems" method="GET" class="row g-3 mb-5 bg-white p-3 rounded border shadow-sm">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Buscar..." value="<%= query.search || '' %>">
    </div>
    <div class="col-md-3">
        <select name="filterType" class="form-select">
            <option value="title" <%= query.filterType === 'title' ? 'selected' : '' %>>Por Título</option>
            <option value="author" <%= query.filterType === 'author' ? 'selected' : '' %>>Por Autor</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="category" class="form-select">
            <option value="">Todas as Categorias</option>
            <% ['Romance', 'Reflexão', 'Natureza', 'Amizade', 'Motivação'].forEach(cat => { %>
                <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-dark w-100">Filtrar</button>
    </div>
</form>

<div class="row">
    <% if(poems.length === 0) { %>
        <div class="text-center text-muted my-5">Nenhum poema encontrado.</div>
    <% } %>
    <% poems.forEach(poem => { %>
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <span class="badge bg-secondary mb-2 align-self-start"><%= poem.category %></span>
                    <h5 class="card-title fw-bold text-dark"><%= poem.title %></h5>
                    <p class="card-text text-muted flex-grow-1 text-truncate" style="max-height: 80px; white-space: pre-line;"><%= poem.content %></p>
                    <div class="mt-3 border-top pt-2 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Por: <a href="/user/profile/<%= poem.author._id %>" class="text-decoration-none"><%= poem.author.name %></a></small>
                        <a href="/poems/<%= poem._id %>" class="btn btn-sm btn-outline-primary">Ler tudo</a>
                    </div>
                </div>
            </div>
        </div>
    <% }) %>
</div>
<%- include('../partials/footer') %>