<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 p-4">
            <h3 class="fw-bold mb-4 text-dark"><i class="fa-solid fa-user-gear text-primary me-2"></i>Editar Perfil</h3>
            
            <% if(typeof error !== 'undefined' && error) { %> 
                <div class="alert alert-danger py-2 small"><%= error %></div> 
            <% } %>

            <form action="/user/edit" method="POST" enctype="multipart/form-data">
                <div class="mb-3 text-center">
                    <img src="/uploads/<%= user.profilePicture %>" 
                         alt="Sua foto atual" 
                         class="rounded-circle img-thumbnail mb-3 shadow-sm" 
                         style="width: 120px; height: 120px; object-fit: cover;"
                         onerror="this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png'">
                    
                    <div class="text-start">
                        <label class="form-label small fw-semibold">Alterar Foto de Perfil</label>
                        <input type="file" name="profilePicture" class="form-control" accept="image/*">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nome ou Pseudônimo</label>
                    <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">Sobre mim (Sua Bio)</label>
                    <textarea name="bio" class="form-control" rows="4" placeholder="Conte um pouco sobre suas inspirações poéticas..."><%= user.bio %></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Salvar Alterações</button>
                    <a href="/user/profile/<%= user._id %>" class="btn btn-light px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>